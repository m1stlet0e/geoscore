generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                 @id @default(cuid())
  email                 String?                @unique
  phone                 String?                @unique
  name                  String?
  passwordHash          String?
  image                 String?
  plan                  Plan                   @default(FREE)
  planExpiresAt         DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  accounts              Account[]
  adminLogs             AdminLog[]
  alerts                Alert[]
  brands                Brand[]
  citations             Citation[]
  citationEvidences     CitationEvidence[]
  citationSources       CitationSource[]
  contentPieces         ContentPiece[]
  forecasts             Forecast[]
  gapAnalyses           GapAnalysis[]
  orders                Order[]
  prompts               Prompt[]
  publishJobs           PublishJob[]
  quotas                Quota[]
  scans                 ScanRun[]
  sessions              Session[]
  subscriptions         Subscription[]
  trendSignals          TrendSignal[]
  recommendationFactors RecommendationFactor[]
}

model Subscription {
  id            String    @id @default(cuid())
  userId        String
  plan          Plan
  status        SubStatus @default(ACTIVE)
  startDate     DateTime  @default(now())
  endDate       DateTime?
  autoRenew     Boolean   @default(true)
  paymentMethod String?
  externalId    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  orders        Order[]
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model Order {
  id             String        @id @default(cuid())
  userId         String
  subscriptionId String?
  orderNo        String        @unique
  plan           Plan
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("CNY")
  status         OrderStatus   @default(PENDING)
  paymentMethod  String?
  paymentId      String?
  paidAt         DateTime?
  expiredAt      DateTime?
  meta           Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments       Payment[]

  @@index([userId, status])
  @@index([orderNo])
}

model Payment {
  id           String    @id @default(cuid())
  orderId      String
  method       String
  amount       Decimal   @db.Decimal(10, 2)
  currency     String    @default("CNY")
  status       PayStatus @default(PENDING)
  externalId   String?
  callbackUrl  String?
  callbackData Json?
  paidAt       DateTime?
  createdAt    DateTime  @default(now())
  order        Order     @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([externalId])
}

model Quota {
  id          String       @id @default(cuid())
  userId      String
  type        QuotaType
  total       Int
  used        Int          @default(0)
  remaining   Int
  period      String
  periodStart DateTime
  periodEnd   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  usages      QuotaUsage[]

  @@unique([userId, type, period, periodStart])
  @@index([userId, type])
}

model QuotaUsage {
  id          String   @id @default(cuid())
  quotaId     String
  amount      Int
  description String?
  meta        Json?
  createdAt   DateTime @default(now())
  quota       Quota    @relation(fields: [quotaId], references: [id], onDelete: Cascade)

  @@index([quotaId, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Brand {
  id                    String                 @id @default(cuid())
  userId                String
  name                  String
  domain                String?
  description           String?
  category              String?
  competitors           String[]
  status                String                 @default("active")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  alerts                Alert[]
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  citations             Citation[]
  citationEvidences     CitationEvidence[]
  citationSources       CitationSource[]
  contentPieces         ContentPiece[]
  forecasts             Forecast[]
  gapAnalyses           GapAnalysis[]
  prompts               Prompt[]
  scans                 ScanRun[]
  trendSignals          TrendSignal[]
  recommendationFactors RecommendationFactor[]

  @@unique([userId, name])
  @@index([userId, status])
}

model Prompt {
  id        String       @id @default(cuid())
  brandId   String
  userId    String
  text      String
  category  String?
  intent    String?
  language  String       @default("zh")
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  brand     Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  scans     PromptScan[]

  @@index([brandId, isActive])
}

model ScanRun {
  id               String       @id @default(cuid())
  brandId          String
  userId           String
  status           String
  totalPrompts     Int          @default(0)
  completedPrompts Int          @default(0)
  platforms        String[]
  startedAt        DateTime     @default(now())
  completedAt      DateTime?
  triggeredBy      String       @default("user")
  errorMsg         String?
  promptScans      PromptScan[]
  brand            Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([brandId, startedAt])
}

model PromptScan {
  id             String   @id @default(cuid())
  scanRunId      String
  promptId       String
  platform       String
  responseText   String?
  citedSources   Json?
  brandMentioned Boolean  @default(false)
  brandRank      Int?
  sentiment      String?
  latencyMs      Int?
  createdAt      DateTime @default(now())
  prompt         Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
  scanRun        ScanRun  @relation(fields: [scanRunId], references: [id], onDelete: Cascade)

  @@index([scanRunId, platform])
  @@index([brandMentioned, platform])
}

model Citation {
  id                 String              @id @default(cuid())
  brandId            String
  userId             String
  platform           String
  promptText         String
  answerText         String
  sources            Json
  brandRank          Int?
  brandContext       String?
  aiScore            Float?
  confidence         Float?
  createdAt          DateTime            @default(now())
  brand              Brand               @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  citationInfluences CitationInfluence[]

  @@index([brandId, platform, createdAt])
  @@index([userId, createdAt])
  @@index([aiScore])
}

model CitationInfluence {
  id           String   @id @default(cuid())
  citationId   String
  sourceUrl    String
  sourceDomain String
  influence    Float
  factor       String?
  createdAt    DateTime @default(now())
  citation     Citation @relation(fields: [citationId], references: [id], onDelete: Cascade)

  @@index([citationId, influence])
}

model CitationSource {
  id            String   @id @default(cuid())
  brandId       String
  userId        String
  domain        String
  platform      String
  url           String
  title         String?
  sourceType    String?
  weight        Float    @default(1.0)
  citationCount Int      @default(1)
  sentiment     String?
  firstSeen     DateTime @default(now())
  lastSeen      DateTime @default(now())
  brand         Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([brandId, platform, url])
  @@index([brandId, weight])
}

model BrandGraphNode {
  id     String @id @default(cuid())
  userId String
  label  String
  type   String
  weight Float  @default(1.0)
  x      Float  @default(0)
  y      Float  @default(0)
}

model BrandGraphEdge {
  id     String @id @default(cuid())
  userId String
  from   String
  to     String
  weight Float  @default(1.0)
  type   String
}

model GapAnalysis {
  id           String    @id @default(cuid())
  brandId      String
  userId       String
  competitorId String?
  platform     String
  promptText   String
  score        Float
  benchmark    Float
  gap          Float
  status       String    @default("pending")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  brand        Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gapItems     GapItem[]

  @@index([brandId, createdAt])
  @@index([userId, gap])
}

model GapItem {
  id            String      @id @default(cuid())
  gapAnalysisId String
  type          String
  title         String
  description   String
  impact        Float
  priority      Int
  status        String      @default("open")
  createdAt     DateTime    @default(now())
  gapAnalysis   GapAnalysis @relation(fields: [gapAnalysisId], references: [id], onDelete: Cascade)

  @@index([gapAnalysisId, priority])
}

model ContentPiece {
  id          String       @id @default(cuid())
  brandId     String
  userId      String
  type        String
  title       String
  body        String
  meta        Json?
  status      String       @default("draft")
  quality     Int?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  brand       Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  publishJobs PublishJob[]

  @@index([brandId, type, status])
}

model PublishJob {
  id          String       @id @default(cuid())
  contentId   String
  userId      String
  channel     String
  status      String       @default("pending")
  externalUrl String?
  response    Json?
  errorMsg    String?
  startedAt   DateTime     @default(now())
  completedAt DateTime?
  content     ContentPiece @relation(fields: [contentId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([contentId, status])
}

model TrendSignal {
  id         String   @id @default(cuid())
  brandId    String?
  userId     String
  category   String
  text       String
  volume     Int      @default(0)
  growthPct  Float    @default(0)
  platforms  String[]
  detectedAt DateTime @default(now())
  brand      Brand?   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, growthPct])
  @@index([category, detectedAt])
}

model Forecast {
  id             String   @id @default(cuid())
  brandId        String
  userId         String
  horizonDays    Int
  predictedScore Float
  predictedRank  Float
  confidence     Float
  drivers        Json
  generatedAt    DateTime @default(now())
  brand          Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([brandId, generatedAt])
}

model Alert {
  id        String   @id @default(cuid())
  brandId   String
  userId    String
  type      String
  severity  String
  title     String
  message   String
  meta      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

model AdminLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  target    String?
  meta      Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  desc      String?
  updatedAt DateTime @updatedAt
}

model CitationEvidence {
  id                   String   @id @default(cuid())
  brandId              String
  userId               String
  platform             String
  prompt               String
  answer               String
  sourceUrl            String?
  sourceType           String?
  recommendationReason String?
  confidence           Float?
  weight               Float?
  factors              Json?
  createdAt            DateTime @default(now())
  brand                Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([brandId, platform])
  @@index([userId, createdAt])
  @@index([sourceType])
}

// ============================================
// Citation Intelligence 2.0 — Recommendation Factor
// 分析 AI 为什么推荐竞品，量化每个因子的影响力
// ============================================
model RecommendationFactor {
  id         String   @id @default(cuid())
  brandId    String
  userId     String
  platform   String
  factor     String // e.g. "GitHub 星数", "知乎热度", "文档质量"
  category   String // e.g. "social_proof", "content_quality", "technical", "community"
  weight     Float    @default(0) // 该因子在推荐中的权重
  impact     Float    @default(0) // 对排名的量化影响 (0-100)
  mentions   Int      @default(0) // 被提及次数
  trend      String   @default("stable") // rising, stable, declining
  competitor String? // 竞品名称
  suggestion String? // 改进建议
  evidence   Json? // 证据来源
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  brand      Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([brandId, platform, factor])
  @@index([brandId, impact])
  @@index([brandId, category])
}

enum Plan {
  FREE
  PRO
  GROWTH
  ENTERPRISE
}

enum SubStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PAUSED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PayStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum QuotaType {
  SCAN
  PROMPT
  CITATION_ANALYSIS
  GAP_ANALYSIS
  CONTENT_GENERATE
  REPORT_GENERATE
}

// =====================================================================
// v2 (geo-core-v2-ocr) — Citation Intelligence + GEO Gap + Growth Agent
// 见 docs/superpowers/specs/2026-06-19-geo-core-v2-ocr-design.md
// 命名前缀 v2 避免与旧表 Citation / GapAnalysis 等混淆
// =====================================================================

model V2PromptLibrary {
  id        String   @id @default(cuid())
  industry  String // 'ocr' 等
  text      String
  category  String // 'comparison' | 'recommendation' | 'how-to' | ...
  language  String   @default("zh")
  source    String   @default("seed") // seed / manual / semi-auto
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scanJobs        V2ScanJob[]
  v2CitationEdges V2CitationEdge[]

  @@unique([industry, text])
  @@index([industry, category])
}

// 节点：要么是品牌 (kind=brand)，要么是引用源 (kind=source)
model V2CitationNode {
  id        String   @id @default(cuid())
  kind      String // 'brand' | 'source'
  name      String // 品牌规范名 / 来源 host
  industry  String? // 'ocr'，brand 必填，source 可空
  aliases   String[] // 别名归一
  meta      Json? // 例如 source 的 type=website/github/doc/media/zhihu，brand 的 domain
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outgoingEdges V2CitationEdge[] @relation("EdgeFrom")
  incomingEdges V2CitationEdge[] @relation("EdgeTo")

  @@unique([kind, industry, name])
  @@index([kind, industry])
}

// 边：在 (promptId, channel, brandNode, sourceNode) 维度去重
model V2CitationEdge {
  id           String   @id @default(cuid())
  promptId     String
  channel      String // 'deepseek' | 'chatgpt'
  brandNodeId  String // V2CitationNode kind=brand
  sourceNodeId String? // V2CitationNode kind=source，nullable
  sourceUrl    String? // 实际命中的 url，用于唯一索引去重
  rank         Int // brand 在该回答里的排名
  confidence   Float // 0..1
  observedAt   DateTime @default(now())

  prompt     V2PromptLibrary @relation(fields: [promptId], references: [id], onDelete: Cascade)
  brandNode  V2CitationNode  @relation("EdgeFrom", fields: [brandNodeId], references: [id])
  sourceNode V2CitationNode? @relation("EdgeTo", fields: [sourceNodeId], references: [id])

  @@unique([promptId, channel, brandNodeId, sourceUrl])
  @@index([brandNodeId, observedAt])
  @@index([promptId, channel])
}

// 当前快照：(brandNodeId, dimension) 唯一
model V2BrandDimension {
  id          String   @id @default(cuid())
  brandNodeId String
  dimension   String // 'github' | 'website' | 'zhihu' | 'media'
  metric      Float // 项目数 / 索引页数 / 提及数
  detail      Json?
  stale       Boolean  @default(false)
  collectedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([brandNodeId, dimension])
  @@index([brandNodeId])
}

// 历史趋势
model V2BrandDimensionSnapshot {
  id          String   @id @default(cuid())
  brandNodeId String
  dimension   String
  metric      Float
  detail      Json?
  stale       Boolean  @default(false)
  collectedAt DateTime @default(now())

  @@index([brandNodeId, dimension, collectedAt])
}

// Gap 报告：只插不改
model V2GapReport {
  id         String   @id @default(cuid())
  brandId    String // 关联现有 Brand 表
  industry   String
  rows       Json // GapRow[]
  narrative  String
  snapshotAt DateTime @default(now())

  @@index([brandId, snapshotAt])
}

// Growth 计划：只插不改
model V2GrowthPlan {
  id          String   @id @default(cuid())
  brandId     String // 关联现有 Brand 表
  industry    String
  actions     Json // GrowthAction[] 长度 3
  generatedAt DateTime @default(now())

  @@index([brandId, generatedAt])
}

// LLM 链路任务
model V2ScanJob {
  id         String    @id @default(cuid())
  brandId    String // 关联现有 Brand 表
  promptId   String
  channel    String // 'deepseek' | 'chatgpt'
  status     String    @default("pending") // pending | running | done | failed
  attempts   Int       @default(0)
  priority   Int       @default(100)
  error      String?
  result     Json? // ExtractedCitation 快照
  batchId    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  startedAt  DateTime?
  finishedAt DateTime?

  prompt V2PromptLibrary @relation(fields: [promptId], references: [id])

  @@unique([brandId, promptId, channel])
  @@index([status, priority, createdAt])
  @@index([batchId])
}

// 采集器任务（Phase 3 才会写入；这里先建表，留空跑）
model V2CollectorRun {
  id          String    @id @default(cuid())
  brandNodeId String
  dimension   String
  status      String    @default("pending")
  attempts    Int       @default(0)
  priority    Int       @default(100)
  error       String?
  result      Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  startedAt   DateTime?
  finishedAt  DateTime?

  @@unique([brandNodeId, dimension])
  @@index([status, priority, createdAt])
}
