DATABASE_URL="postgresql://wangbo@localhost/geoos?schema=public"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
CRON_SECRET="generate-with-openssl-rand-base64-32"
DEEPSEEK_API_KEY="sk-your-key-here"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
NEXT_PUBLIC_APP_NAME="GeoOS"
NEXT_PUBLIC_APP_TAGLINE="Rank In AI, Not Just Google"

# 微信开放平台 OAuth（可选，用于微信登录）
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 支付宝开放平台 OAuth（可选，用于支付宝登录）
ALIPAY_APP_ID=
ALIPAY_APP_SECRET=

# ============================================
# 微信支付配置
# 文档：https://pay.weixin.qq.com
# ============================================
WECHAT_MCH_ID=          # 商户号
WECHAT_API_KEY=         # API v3 密钥
WECHAT_SERIAL_NO=       # 商户证书序列号
WECHAT_PRIVATE_KEY=     # 商户私钥（单行，\n 换行）

# ============================================
# 支付宝配置
# 文档：https://open.alipay.com
# ============================================
ALIPAY_APP_ID=          # 应用 ID
ALIPAY_PRIVATE_KEY=     # 应用私钥（单行，\n 换行）
ALIPAY_PUBLIC_KEY=      # 支付宝公钥

# ============================================
# Payjs 配置（个人可用，无需营业执照）
# 注册：https://payjs.cn
# ============================================
PAYJS_MCHID=          # 商户号
PAYJS_KEY=            # 密钥
